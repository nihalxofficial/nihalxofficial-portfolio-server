# portfolio-server environment TEMPLATE
# Copy .env.example -> .env and fill in the values.

# Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Database
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=portfolio

# Admin Authorization (comma-separated admin emails)
ADMIN_EMAILS=mdnihaluddinbijoy@gmail.com

# AI Assistant & Form Writer (Google Gemini)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Contact + Notification Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=

# Media Storage (ImgBB)
# Get key at: https://api.imgbb.com/
IMGBB_API_KEY=
IMGBB_EXPIRATION=
