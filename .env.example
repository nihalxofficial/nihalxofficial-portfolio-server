# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# portfolio-server environment TEMPLATE
#
#   copy .env.example  ->  .env   then fill the values in .env only.
#   Never put real keys in this file: it is committed to git.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Runtime â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NODE_ENV=development
PORT=5000
# Public origin(s) of the frontend, comma separated. Used by CORS.
FRONTEND_URL=http://localhost:3000

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# MongoDB Atlas: Cluster -> Connect -> Drivers -> copy the connection string,
# replace <password>, and put the database name before the "?". Example:
# mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name used inside that cluster (the URI above often omits it).
MONGODB_DATABASE=portfolio

# â”€â”€ Admin authorization â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Firebase UID(s) allowed to enter the dashboard, comma separated.
# Firebase console -> Authentication -> Users -> copy the "User UID".
# The server is the only thing that decides who is admin; the browser cannot.
ADMIN_UIDS=

# â”€â”€ Firebase Admin (server-side ID token verification) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# then paste three fields out of the downloaded JSON:
#   project_id                -> FIREBASE_PROJECT_ID
#   client_email              -> FIREBASE_CLIENT_EMAIL
#   private_key (keep the \n) -> FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional alternative: absolute path to that service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# â”€â”€ AI assistant + dashboard writing assistant (Google Gemini) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# One key powers both features:
#   1. public chat assistant answering visitors about you
#   2. private "fill the form for me" button inside the dashboard
# Get it at https://aistudio.google.com/apikey  ->  Create API key.
# No other AI provider is required.
GEMINI_API_KEY=
# gemini-3.8-flash: fast, cheap, supports JSON output.
# Use -flash-lite for lower cost, or -pro for better long-form writing.
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the primary model returns 503 (overloaded).
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# â”€â”€ Contact + notification email (SMTP, provider agnostic) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Every contact form submission is stored in MongoDB first, then emailed.
# If SMTP is left empty the message is still saved, the dashboard still shows it.
#
# SMTP_HOST      smtp.gmail.com       | smtp-relay.brevo.com   | smtp.resend.com
#                smtp.mailgun.org     | smtp.zoho.com          | sandbox.smtp.mailtrap.io
# SMTP_PORT      587 (STARTTLS)  or  465 (implicit TLS)
# SMTP_SECURE    true only for port 465, false for 587/25
#
# Gmail: enable 2-Step Verification -> Google Account -> App passwords ->
#   create "Portfolio" -> use the 16 character value in SMTP_PASSWORD.
#   Gmail ignores your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where the "new contact message" notifications land.
# Leave empty to use SMTP_USER (for Gmail that is the same inbox).
CONTACT_RECEIVER_EMAIL=

# â”€â”€ Media storage (ImgBB) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Dashboard image uploads. Files are never stored on the server, they go to
# ImgBB and this app keeps only the returned CDN urls in MongoDB.
# Get a key: https://api.imgbb.com/  ->  log in -> "Get API key".
IMGBB_API_KEY=
# Optional auto-expiry in seconds (60 .. 15552000). Leave empty for permanent.
IMGBB_EXPIRATION=
